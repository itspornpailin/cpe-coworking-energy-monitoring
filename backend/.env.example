APP_ENV=development

SERVER_PORT=8080

FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/cpe_coworking?sslmode=disable

SESSION_TTL=8h

MQTT_ENABLED=true # true if MQTT, false if not
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=cpe-web-backend

MQTT_ENV_TOPIC=greenoffice/sensor/env/+
MQTT_AC_TOPIC=greenoffice/sensor/ac/+
MQTT_DOOR_TOPIC=greenoffice/sensor/door/+

MQTT_USERNAME=
MQTT_PASSWORD=

# How often one node's reading is saved to PostgreSQL (the live dashboard values always use every message).
# Averages over 5 minutes, 1 hour, etc. are worked out from these rows when asked for. Minimum 1s.
READING_SAVE_INTERVAL=1m

# Development only: publish fake readings for 7 demo room nodes and 7 demo air conditioners
# (no hardware or broker needed). Refused unless APP_ENV=development.
# They are named demo_env_01 ... demo_env_07 and demo_ac_01 ... demo_ac_07.
MOCK_SENSORS=false
MOCK_SENSOR_INTERVAL=10s
# Optional: pretend it is this hour (0-23) so a demo shows daylight readings in the evening.
# MOCK_SENSOR_HOUR=13